   "source": [
    "class MiniBatchBotRGCN(torch.nn.Module):\n",
    "    def __init__(self, num_features, hidden_dim, num_classes, num_relations, num_bases=None, dropout=0.2):\n",
    "        super().__init__()\n",
    "\n",
    "        self.bn_in = nn.BatchNorm1d(num_features)\n",
    "        self.lin_in = nn.Linear(num_features, hidden_dim)\n",
    "\n",
    "        self.rgcn1 = FastRGCNConv(\n",
    "            in_channels=hidden_dim,\n",
    "            out_channels=hidden_dim,\n",
    "            num_relations=num_relations,\n",
    "            num_bases=num_bases\n",
    "        )\n",
    "\n",
    "        self.rgcn2 = FastRGCNConv(\n",
    "            in_channels=hidden_dim,\n",
    "            out_channels=hidden_dim,\n",
    "            num_relations=num_relations,\n",
    "            num_bases=num_bases\n",
    "        )\n",
    "\n",
    "        self.bn_hidden = nn.BatchNorm1d(hidden_dim)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "\n",
    "        self.lin_hidden = nn.Linear(hidden_dim, hidden_dim // 2)\n",
    "        self.lin_out = nn.Linear(hidden_dim // 2, num_classes)\n",
    "\n",
    "    def forward(self, x, edge_index, edge_type):\n",
    "        x = self.bn_in(x)\n",
    "        x = F.leaky_relu(self.lin_in(x))\n",
    "\n",
    "        x = self.rgcn1(x, edge_index, edge_type)\n",
    "        x = F.leaky_relu(x)\n",
    "        x = self.dropout(x)\n",
    "\n",
    "        x = self.rgcn2(x, edge_index, edge_type)\n",
    "        x = F.leaky_relu(x)\n",
    "        x = self.dropout(x)\n",
    "\n",
    "        x = self.bn_hidden(x)\n",
    "        x = F.leaky_relu(self.lin_hidden(x))\n",
    "        x = self.dropout(x)\n",
    "\n",
    "        x = self.lin_out(x)\n",
    "        return x"
   ]
  },
