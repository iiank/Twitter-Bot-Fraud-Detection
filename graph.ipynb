    "@torch.no_grad()\n",
    "def get_probs_rgcn(model, loader, device, relation_to_idx):\n",
    "    model.eval()\n",
    "\n",
    "    all_probs = []\n",
    "    all_true = []\n",
    "\n",
    "    for hetero_batch in loader:\n",
    "        hetero_batch = hetero_batch.to(device)\n",
    "\n",
    "        # convert hetero → homogeneous RGCN batch\n",
    "        batch = hetero_batch_to_rgcn_batch(hetero_batch, relation_to_idx, device)\n",
    "\n",
    "        out = model(batch.x, batch.edge_index, batch.edge_type)\n",
    "\n",
    "        seed_count = batch.batch_size\n",
    "        logits = out[:seed_count]\n",
    "\n",
    "        probs = torch.softmax(logits, dim=1)[:, 1]  # probability of class 1 (bot)\n",
    "\n",
    "        all_probs.append(probs.cpu())\n",
    "        all_true.append(batch.y[:seed_count].cpu())\n",
    "\n",
    "    y_true = torch.cat(all_true).numpy()\n",
    "    y_probs = torch.cat(all_probs).numpy()\n",
    "\n",
    "    return y_true, y_probs"
   ]
