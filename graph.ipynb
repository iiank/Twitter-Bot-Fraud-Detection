    "    early_stopping_patience=10\n",
    "):\n",
    "    history = {\n",
    "        \"train_loss\": [],\n",
    "        \"val_loss\": [],\n",
    "        \"val_precision\": [],\n",
    "        \"val_recall\": [],\n",
    "        \"val_accuracy\": [],\n",
    "        \"val_f1\": []\n",
    "    }\n",
    "\n",
    "    best_val_loss = float(\"inf\")\n",
    "    best_state = None\n",
    "    patience_counter = 0\n",
    "\n",
    "    for ep in range(epoch):\n",
    "        train_loss = train_rgcn_minibatch(\n",
    "            model, train_loader, criterion, optimizer, device, relation_to_idx\n",
    "        )\n",
    "        val_loss, precision, recall, accuracy, f1, _, _ = evaluate_rgcn_minibatch(\n",
    "            model, val_loader, criterion, device, relation_to_idx\n",
    "        )\n",
    "\n",
    "        history[\"train_loss\"].append(train_loss)\n",
    "        history[\"val_loss\"].append(val_loss)\n",
    "        history[\"val_precision\"].append(precision)\n",
    "        history[\"val_recall\"].append(recall)\n",
    "        history[\"val_accuracy\"].append(accuracy)\n",
    "        history[\"val_f1\"].append(f1)\n",
    "\n",
    "        print(\n",
